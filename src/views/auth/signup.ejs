<%- include('../partials/header') %>

<section class="container-con prompt">
    <h1 class="login-title">안녕하세요&nbsp;<br/>
        <div>
            <div class="login-title"><span class="blend-effect">express</span>로 구현한 웹 어플리케이션입니다</div>
            
        </div>
    </h1>
    <form action="/auth/signup" method="post" class="login-cont--wrapper">
        <div>
            <p class="login-subtitle mb-1">회원가입이 필요합니다</p>
            <p class="login-subtitle mb-2">테스트를 위한 계정으로 입력해주세요</p>
        </div>
        <div class="login-input--wrapper">
            <label for="email" class="input--text">이메일</label>
            <input id="email" name="email" type="text" class="input--box" placeholder="이메일을 입력하세요" required />
        </div>
        <div class="login-input--wrapper">
            <label for="username" class="input--text">사용자 이름</label>
            <input id="username" name="username" type="text" class="input--box" placeholder="사용자 이름을 입력하세요"  required />
        </div>
        <div class="login-input--wrapper">
            <label for="password" class="input--text">패스워드</label>
            <input id="password" name="password" type="password" class="input--box" placeholder="패스워드를 입력하세요" required />
        </div>
        <button type="submit" class="login-submit--btn">회원가입</button>
        <div class="mt-3 mb-2">
            <p class="flex-wrapper flex-wrapper--login f-sm">아이디가 있으신가요?&nbsp;&nbsp;<a href="/login">로그인</a></p></div>
    </form>
</section>

<%- include('../partials/footer') %>