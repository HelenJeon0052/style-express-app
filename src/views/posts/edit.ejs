<%- include('../partials/header') %>
<div class="width-adjust">
    <div class="height-adjust">
        <h5 class="post-edit--title">edit post</h5>
        <div class="post-edit">
            <hr>
            <form action="/posts/<%= post._id %>?_method=PUT" method="POST">
                <div class="post-edit--wrapper">
                    <textarea class="post-edit--textarea" id="desc" name="description"><%= post.description %></textarea>
                </div>
                <button type="submit" class="post-edit--btn btn-primary mt-3">수정하기</button>
            </form>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>